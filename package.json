{
  "name": "marginalia",
  "private": true,
  "version": "0.1.0-prototype.6",
  "description": "Private Windows app for book highlights and Markdown quotes (Tauri 2).",
  "repository": {
    "type": "git",
    "url": "https://github.com/samwe20/Marginalia.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node scripts/build-fixtures.mjs",
    "test:e2e": "npm run fixtures && playwright test",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:windows": "tauri build --target x86_64-pc-windows-msvc",
    "test:desktop-smoke": "wdio run tests/desktop/wdio.conf.cjs",
    "test:desktop-stress": "wdio run tests/desktop/wdio.stress.conf.cjs",
    "generate:stress-library": "node scripts/ci/generate-stress-library.mjs"
  },
  "dependencies": {
    "@citation-js/core": "^0.7.18",
    "@citation-js/plugin-csl": "^0.7.14",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-store": "^2",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.18",
    "foliate-js": "^1.0.1",
    "marked": "^15.0.12",
    "pdfjs-dist": "^4.10.38",
    "ulidx": "^2.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@wdio/cli": "^9.20.0",
    "@wdio/globals": "^9.17.0",
    "@wdio/local-runner": "^9.20.0",
    "@wdio/mocha-framework": "^9.20.0",
    "@wdio/spec-reporter": "^9.20.0",
    "@wdio/tauri-service": "^1.5.1",
    "jsdom": "^26.1.0",
    "jszip": "^3.10.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
